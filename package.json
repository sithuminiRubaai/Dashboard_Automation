{
  "name": "cucumber_playwright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "pretest": "npx ts-node src/helper/init.ts",
    "test": "cucumber-js -p default",
    "test:dev": "cross-env ENV=dev npm test",
    "test:uat": "cross-env ENV=uat npm test",
    "test:staging": "cross-env ENV=staging npm test",
    "test:chromium": "cross-env BROWSER=chromium cucumber-js -p default",
    "test:firefox": "cross-env BROWSER=firefox cucumber-js -p default",
    "test:chromium-firefox": "npm run test:chromium && npm run test:firefox",
    "test:smoke:chromium": "cross-env BROWSER=chromium cucumber-js -p default --tags @smoke",
    "test:smoke:firefox": "cross-env BROWSER=firefox cucumber-js -p default --tags @smoke",
    "test:smoke:chromium-firefox": "npm run test:smoke:chromium && npm run test:smoke:firefox",
    "format:features": "node scripts/format-feature-files.js",
    "test:all": "node scripts/run-all-environments.js",
    "posttest": "npx ts-node src/test/utils/report.ts",
    "test:failed": "cucumber-js -p rerun @rerun.txt"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^12.6.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "fs-extra": "^11.3.3",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "winston": "^3.18.3"
  }
}
